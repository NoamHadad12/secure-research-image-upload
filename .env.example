# Local development only. Copy this file to .env to override the safe defaults
# in docker-compose.yml. Never use production credentials in this project.
POSTGRES_DB=research_uploads
POSTGRES_USER=research_app
POSTGRES_PASSWORD=replace-with-a-local-postgres-password

MINIO_ROOT_USER=local-minio-admin
MINIO_ROOT_PASSWORD=replace-with-a-local-minio-password
MINIO_BUCKET=research-images
MINIO_REGION=us-east-1
MINIO_INTERNAL_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000

FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000
